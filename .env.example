# Destination email where submissions (volunteers, newsletter alerts) will be sent
CONTACT_EMAIL=thegreenevent.44@gmail.com

# Nodemailer / Gmail Configuration
# For Gmail, you must use an "App Password" (16 characters) 
# generated in your Google Account Security settings.
EMAIL_USER=thegreenevent44120@gmail.com
EMAIL_PASS=your_16_character_app_password_here

# --- Strapi CMS ---
# URL de l'API Strapi (sans slash final)
STRAPI_URL=http://localhost:1337
# Token API en lecture seule (optionnel si le rôle public est ouvert en lecture)
STRAPI_API_TOKEN=
# Secret partagé avec le webhook Strapi pour la revalidation ISR
REVALIDATE_SECRET=change-me
